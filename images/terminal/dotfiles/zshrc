# ~/.zshrc — terminal web SSP Cloud

# --- PATH et ajouts des scripts d'init --------------------------------------
# Installations utilisateur (pipx, uv tool, claude...)
[[ -d "$HOME/.local/bin" && :$PATH: != *":$HOME/.local/bin:"* ]] && PATH="$HOME/.local/bin:$PATH"
# Les scripts d'init Onyxia écrivent souvent dans ~/.bashrc (PATH, alias) :
# on reprend ce qui y a été ajouté après la config de l'image.
[[ -r "$HOME/.bashrc" ]] && \
    source <(sed -n "/^# >>> fin de la configuration de l'image/,\$p" "$HOME/.bashrc" | tail -n +2) 2>/dev/null

# --- Historique (stocké dans work/ pour survivre aux redémarrages) ----------
HISTFILE="${HISTFILE:-$HOME/work/.zsh_history}"
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE EXTENDED_HISTORY
setopt AUTO_CD INTERACTIVE_COMMENTS

# --- Complétion -------------------------------------------------------------
autoload -Uz compinit && compinit -d "$HOME/.cache/zcompdump"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
bindkey -e

# --- Outils -----------------------------------------------------------------
command -v fzf      >/dev/null && source <(fzf --zsh)        # Ctrl+R, Ctrl+T, Alt+C
command -v zoxide   >/dev/null && eval "$(zoxide init zsh)"  # z <dossier>
command -v kubectl  >/dev/null && source <(kubectl completion zsh)
command -v helm     >/dev/null && source <(helm completion zsh)
command -v starship >/dev/null && eval "$(starship init zsh)"

alias ls='eza --group-directories-first'
alias ll='eza -la --git --group-directories-first'
alias lt='eza --tree --level=2'
alias k='kubectl'

# --- Plugins (syntax-highlighting doit être chargé en dernier) ---------------
[[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
    source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && \
    source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
